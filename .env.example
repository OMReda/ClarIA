# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://plateforme:plateforme@postgres:5432/plateforme
DATABASE_URL_SYNC=postgresql+psycopg2://plateforme:plateforme@postgres:5432/plateforme

# ─── Redis + Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_ALWAYS_EAGER=False

# ─── Storage ───────────────────────────────────────────────────────────────────
STORAGE_PATH=/app/storage

# ─── File limits (configurable per spec §3.1) ─────────────────────────────────
MAX_FILE_SIZE_MB=10
MAX_ROWS=100000

# ─── Rate limiting (per spec §11) ─────────────────────────────────────────────
RATE_LIMIT_PROMPTS_PER_HOUR=30

# ── Template File (Example) ───────────────────────────────────────────────────
# Used to document expected variables or to create .env if it doesn't exist.

# ─── LLM provider ──────────────────────────────────────────────────────────────
# Options: local | openai | anthropic
LLM_PROVIDER=local
LLM_MODEL=ollama/qwen2.5-coder:7b

# Local Ollama base URL (used when LLM_PROVIDER=local)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Cloud provider keys (only needed when LLM_PROVIDER != local)
# WARNING: when using a cloud provider, PandasAI sends up to 10 sample rows
# from your dataframe to the external LLM API. Operator consent required.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# ─── LLM timeout ───────────────────────────────────────────────────────────────
LLM_TIMEOUT_SECONDS=60

# ─── Fuzzy match thresholds ────────────────────────────────────────────────────
FUZZY_HIGH_THRESHOLD=80
FUZZY_MID_THRESHOLD=50

# ─── CORS (frontend origin) ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173
